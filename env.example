# Copy this file to .env and replace the placeholder with your Gemini API key.
GEMINI_API_KEY=your-api-key

# Optional: override the default model.
# GEMINI_MODEL=gemini-3.6-flash

# Optional: override instance/ai_resume.sqlite3.
# DATABASE_PATH=C:/path/to/ai_resume.sqlite3

# Optional: persistent signing key for browser sessions.
# SECRET_KEY=replace-with-a-long-random-value
